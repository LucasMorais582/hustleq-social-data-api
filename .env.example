NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase PostgreSQL connection strings (never commit real credentials).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Provider credentials — add when provider integration starts.
APIFY_API_TOKEN=

# Add only after the authentication contract with HustleQ Beta is decided.
# AUTH_ISSUER=
# AUTH_AUDIENCE=

# JWT Bearer HS256: generate a random secret with at least 32 characters.
JWT_SECRET=
JWT_ISSUER=hustleq
JWT_AUDIENCE=hustleq-social-data-api

# Rotina diária: habilitar somente após configurar o deploy e confirmar os custos.
CRON_SECRET=
INSTAGRAM_REFRESH_ENABLED=false

# Processo separado (Railway/VPS); habilitar somente no servico do worker.
INSTAGRAM_WORKER_ENABLED=false
INSTAGRAM_WORKER_POLL_MS=5000

# Teto de seguranca por usuario/dia UTC; tarefas aceitas contam mesmo se falharem.
INSTAGRAM_MANUAL_REFRESH_DAILY_LIMIT=10

# Discover enfileira e responde 202 sem aguardar o worker. Cache valido responde 200.

# Daily Sync: perfis do mesmo dono por lote (1 a 10). Agendamento em America/New_York.
INSTAGRAM_DAILY_BATCH_SIZE=5
INSTAGRAM_INITIAL_MAX_POSTS=500
