generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InstagramMediaType {
  photo
  carousel
  reel
}

enum InstagramSyncJobType {
  INITIAL_PROFILE_SYNC
  DAILY_PROFILE_SYNC
  WATCHED_SYNC
  POST_REFRESH
  DISCOVER_SEARCH
}

enum InstagramSyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model InstagramProfile {
  id                  String    @id @default(cuid())
  // ID externo do usuário HustleQ. A atribuição será feita pelas rotas internas.
  // Não há tabela User na Social Data API.
  ownerUserId         String?
  instagramId         String    @unique
  username            String
  name                String?
  url                 String?
  bio                 String?
  profilePhoto        String?
  category            String?
  isVerified          Boolean?
  reservedForInviteId String?
  reservedUntil       DateTime? @db.Timestamptz(3)
  monitoringUntil     DateTime? @db.Timestamptz(3)
  syncStatus          String    @default("pending")
  lastSyncedAt        DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  snapshots            InstagramProfileSnapshot[]
  posts                InstagramPost[]
  monitoredCompetitors InstagramCompetitor[]      @relation("MonitoringProfile")
  monitoredBy          InstagramCompetitor[]      @relation("CompetitorProfile")
  syncJobs             InstagramSyncJob[]

  @@index([ownerUserId])
  @@index([username])
}

model InstagramProfileSnapshot {
  id                 String   @id @default(cuid())
  instagramProfileId String
  followers          Int?
  following          Int?
  postsCount         Int?
  source             String?
  collectedAt        DateTime @default(now()) @db.Timestamptz(3)

  instagramProfile InstagramProfile @relation(fields: [instagramProfileId], references: [id], onDelete: Restrict)

  // A deduplicacao por dia NY dos jobs exige validacao transacional.
  @@unique([instagramProfileId, collectedAt])
}

model InstagramCompetitor {
  id                  String    @id @default(cuid())
  instagramProfileId  String
  competitorProfileId String
  startedAt           DateTime  @default(now()) @db.Timestamptz(3)
  endedAt             DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  instagramProfile  InstagramProfile @relation("MonitoringProfile", fields: [instagramProfileId], references: [id], onDelete: Restrict)
  competitorProfile InstagramProfile @relation("CompetitorProfile", fields: [competitorProfileId], references: [id], onDelete: Restrict)

  // Cada retomada cria outra relação; não há unicidade do par ao longo do histórico.
  // Limite de três ativos e validação de autorreferência ficam na persistência.
  @@index([instagramProfileId, endedAt])
  @@index([competitorProfileId])
}

model InstagramPost {
  id                 String             @id @default(cuid())
  instagramProfileId String
  instagramPostId    String             @unique
  url                String?
  type               InstagramMediaType
  caption            String?
  hashtags           String[]           @default([])
  displayUrl         String?
  images             String[]           @default([])
  timestamp          DateTime?          @db.Timestamptz(3)
  ownerUsername      String?
  lastCollectedAt    DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  instagramProfile InstagramProfile              @relation(fields: [instagramProfileId], references: [id], onDelete: Restrict)
  metricSnapshots  InstagramPostMetricSnapshot[]
  syncJobs         InstagramSyncJob[]

  @@index([instagramProfileId, timestamp])
}

model InstagramPostMetricSnapshot {
  id              String   @id @default(cuid())
  // Chave do registro interno InstagramPost.id, não o identificador externo.
  instagramPostId String
  likesCount      Int?
  likesHidden     Boolean  @default(false)
  // Nulo apenas nos snapshots legados; novas gravações devem informar a origem.
  source          String?
  commentsCount   Int?
  viewsCount      BigInt?
  collectedAt     DateTime @default(now()) @db.Timestamptz(3)

  instagramPost InstagramPost @relation(fields: [instagramPostId], references: [id], onDelete: Restrict)

  @@index([instagramPostId, collectedAt])
}

model DiscoverCache {
  id        String   @id @default(cuid())
  key       String   @unique
  niche     String?
  city      String?
  query     String?
  results   Json
  fetchedAt DateTime @default(now()) @db.Timestamptz(3)
}

model ProviderRun {
  id                 String    @id @default(cuid())
  actor              String
  apifyRunId         String?
  trigger            String
  instagramProfileId String?
  // InstagramPost.id interno, não instagramPostId externo.
  instagramPostId    String?
  // ID externo da HustleQ; não há tabela User nesta API.
  userId             String?
  items              Int?
  costUsd            Decimal?  @db.Decimal(10, 6)
  status             String
  error              String?
  startedAt          DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt         DateTime? @db.Timestamptz(3)

  @@index([userId, startedAt])
  @@index([instagramPostId, status])
  @@index([instagramProfileId, status])
}

// Fila durável na VPS. Não representa uma execução de Actor ou seu custo.
model InstagramSyncJob {
  id                 String                 @id @default(cuid())
  type               InstagramSyncJobType
  status             InstagramSyncJobStatus @default(PENDING)
  trigger            String
  instagramProfileId String?
  // InstagramPost.id interno, não o identificador externo do Instagram.
  instagramPostId    String?
  userId             String?
  // Dados mínimos para executar a tarefa; nunca tokens ou credenciais.
  payload            Json?
  // Chave compartilhada pelos jobs do mesmo recurso enquanto pendentes/em execução.
  // A conclusão deve limpá-la para permitir novas coletas, preservando o histórico.
  activeKey          String?                @unique
  attempts           Int                    @default(0)
  runAt              DateTime               @default(now()) @db.Timestamptz(3)
  lockedAt           DateTime?              @db.Timestamptz(3)
  leaseExpiresAt     DateTime?              @db.Timestamptz(3)
  // Token de posse do worker; a retomada futura deve trocar esse token.
  lockToken          String?
  lastError          String?
  finishedAt         DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)

  instagramProfile InstagramProfile? @relation(fields: [instagramProfileId], references: [id], onDelete: Restrict)
  instagramPost    InstagramPost?    @relation(fields: [instagramPostId], references: [id], onDelete: Restrict)

  @@index([status, runAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([instagramProfileId, createdAt])
  @@index([instagramPostId, createdAt])
}
