[Unit]
Description=Enqueue daily Instagram jobs
After=hustleq-api.service network-online.target

[Service]
Type=oneshot
User=hustleq
Group=hustleq
EnvironmentFile=/etc/hustleq/social-data-api.env
ExecStart=/usr/bin/node /opt/hustleq-social-data-api/deploy/instagram-cron.mjs
TimeoutStartSec=250
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
